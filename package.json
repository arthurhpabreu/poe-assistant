{
  "name": "poe-assistant",
  "version": "0.3.1",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/arthurhpabreu/poe-assistant.git" },
  "private": true,
  "type": "module",
  "description": "Native Claude/Codex assistant for Path of Building Community Fork",
  "scripts": {
    "install:addon": "node scripts/install.mjs",
    "uninstall:addon": "node scripts/install.mjs --uninstall",
    "start": "node src/server.mjs",
    "package:windows": "node scripts/package.mjs",
    "verify:lab": "node scripts/verify-build-lab.mjs",
    "benchmark:lab": "node scripts/benchmark-lab.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "@xmldom/xmldom": "^0.8.11" },
  "devDependencies": { "fengari": "^0.1.5" }
}
